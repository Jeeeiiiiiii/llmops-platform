  "cards": [
    {
      "dot": "cyan",
      "title": "One orchestrator",
      "items": [
        "The gateway calls retriever and vLLM; they never call each other",
        "Retriever embeds the query itself with the same MiniLM model",
        "Cost is estimated in-process at $0.15 and $0.60 per million tokens"
      ]
    },
    {
      "dot": "emerald",
      "title": "Guardrails are libraries",
      "items": [
        "input_validator and output_filter are imported, not deployed",
        "Both are called with no config, so DEFAULT_CONFIG in the module wins",
        "The chart's guardrail settings in gateway.yaml are never read"
      ]
    },
    {
      "dot": "rose",
      "title": "Authentication is open",
      "items": [
        "app.py reads API_KEYS_FILE; the chart sets API_KEY_SECRET_NAME",
        "With no keys loaded, verify_api_key returns anonymous for everyone",
        "Rate limiting then buckets all callers together under one key"
      ]
    },
    {
      "dot": "amber",
      "title": "Config that does nothing",
      "items": [
        "gateway.yaml is mounted at /app/config but never opened",
        "MAX_INPUT_TOKENS, REQUEST_TIMEOUT and AUTH_ENABLED are unread",
        "RATE_LIMIT_RPM is read by the app but never set by the chart"
      ]
    },
    {
      "dot": "slate",
      "title": "Duplicate manifests",
      "items": [
        "serving/deployment.yaml defines a second vllm-inference Deployment",
        "Neither Jenkinsfile nor the umbrella chart ever applies it",
        "infrastructure/helm/vllm is what actually runs"
      ]
    }
  ]
}
