{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource for LLMOps metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "LLM response quality: eval relevance, user feedback, guardrail block rate, response lengths, and retrieval quality.",
  "editable": true,
  "gnetId": null,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Average Eval Relevance Score Over Time",
      "description": "Rolling average of automated evaluation relevance scores. Computed as cosine similarity between model output and expected answers.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "scheme",
            "showPoints": "auto",
            "axisLabel": "Relevance Score"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 0.5, "color": "yellow" },
              { "value": 0.7, "color": "green" }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Baseline threshold" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } },
              { "id": "custom.fillOpacity", "value": 0 }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "avg(llm_eval_relevance_score{namespace=\"llmops\"})",
          "legendFormat": "Avg relevance",
          "refId": "A"
        },
        {
          "expr": "avg_over_time(llm_eval_relevance_score{namespace=\"llmops\"}[1h])",
          "legendFormat": "1h rolling avg",
          "refId": "B"
        },
        {
          "expr": "vector(0.7)",
          "legendFormat": "Baseline threshold",
          "refId": "C"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "min", "lastNotNull"] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "title": "User Feedback — Thumbs Up / Down Ratio",
      "description": "Ratio of positive to negative user feedback. Values below 0.6 trigger a quality degradation alert.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "scheme",
            "showPoints": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 0.5, "color": "yellow" },
              { "value": 0.7, "color": "green" }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Thumbs up count" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "#73bf69", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Thumbs down count" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "#f2495c", "mode": "fixed" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum(rate(llm_user_feedback_total{namespace=\"llmops\", rating=\"positive\"}[1h])) / (sum(rate(llm_user_feedback_total{namespace=\"llmops\"}[1h])) > 0)",
          "legendFormat": "Positive ratio",
          "refId": "A"
        },
        {
          "expr": "sum(increase(llm_user_feedback_total{namespace=\"llmops\", rating=\"positive\"}[1h]))",
          "legendFormat": "Thumbs up count",
          "refId": "B"
        },
        {
          "expr": "sum(increase(llm_user_feedback_total{namespace=\"llmops\", rating=\"negative\"}[1h]))",
          "legendFormat": "Thumbs down count",
          "refId": "C"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "sum", "lastNotNull"] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "title": "Guardrail Block Rate (Input + Output)",
      "description": "Percentage of requests blocked by input validation or output filtering guardrails.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "scheme",
            "showPoints": "never",
            "stacking": { "mode": "none" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 0.1, "color": "yellow" },
              { "value": 0.15, "color": "red" }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Input block rate" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "#e0b400", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Output block rate" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "#f2495c", "mode": "fixed" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum(rate(guardrail_blocks_total{namespace=\"llmops\", stage=\"input\"}[5m])) / (sum(rate(chat_latency_seconds_count{namespace=\"llmops\"}[5m])) > 0)",
          "legendFormat": "Input block rate",
          "refId": "A"
        },
        {
          "expr": "sum(rate(guardrail_blocks_total{namespace=\"llmops\", stage=\"output\"}[5m])) / (sum(rate(chat_latency_seconds_count{namespace=\"llmops\"}[5m])) > 0)",
          "legendFormat": "Output block rate",
          "refId": "B"
        },
        {
          "expr": "(sum(rate(guardrail_blocks_total{namespace=\"llmops\"}[5m]))) / (sum(rate(chat_latency_seconds_count{namespace=\"llmops\"}[5m])) > 0)",
          "legendFormat": "Combined block rate",
          "refId": "C"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "title": "Response Length Distribution",
      "description": "Distribution of LLM response lengths in characters, broken into histogram buckets.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "scheme",
            "showPoints": "never",
            "axisLabel": "Characters"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(llm_response_length_chars_bucket{namespace=\"llmops\"}[5m])) by (le))",
          "legendFormat": "p50 length",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(llm_response_length_chars_bucket{namespace=\"llmops\"}[5m])) by (le))",
          "legendFormat": "p90 length",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(llm_response_length_chars_bucket{namespace=\"llmops\"}[5m])) by (le))",
          "legendFormat": "p99 length",
          "refId": "C"
        },
        {
          "expr": "sum(rate(llm_response_length_chars_sum{namespace=\"llmops\"}[5m])) / sum(rate(llm_response_length_chars_count{namespace=\"llmops\"}[5m]))",
          "legendFormat": "avg length",
          "refId": "D"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull"] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "title": "Retrieval Relevance Scores",
      "description": "Average and percentile relevance scores from the retriever service. Low values indicate embedding drift or stale index.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "id": 5,
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "scheme",
            "showPoints": "auto",
            "axisLabel": "Score"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 0.5, "color": "yellow" },
              { "value": 0.7, "color": "green" }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Quality threshold" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } },
              { "id": "custom.fillOpacity", "value": 0 }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "avg_relevance_score{namespace=\"llmops\", quantile=\"0.5\"}",
          "legendFormat": "p50 relevance",
          "refId": "A"
        },
        {
          "expr": "avg_over_time(avg_relevance_score_sum{namespace=\"llmops\"}[5m]) / avg_over_time(avg_relevance_score_count{namespace=\"llmops\"}[5m])",
          "legendFormat": "avg relevance (5m)",
          "refId": "B"
        },
        {
          "expr": "vector(0.5)",
          "legendFormat": "Quality threshold",
          "refId": "C"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "min", "lastNotNull"] },
        "tooltip": { "mode": "multi" }
      }
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["llmops", "quality", "evaluation", "guardrails"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "llmops", "value": "llmops" },
        "hide": 0,
        "label": "Namespace",
        "name": "namespace",
        "options": [],
        "query": "label_values(guardrail_blocks_total, namespace)",
        "refresh": 2,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "LLMOps - Quality Metrics",
  "uid": "llmops-quality",
  "version": 1
}
